{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "ignorePatterns": [
    "site/assets/vendor/**",
    "site/assets/js/tides-modules/README.md",
    "site/assets/js/tides-modules/TODO.md",
    "site/assets/js/tides-modules/PROGRESS.md"
  ],
  "overrides": [
    {
      "files": [
        "site/assets/js/tides-refactored.js",
        "site/assets/js/tides-modules/**/*.js",
        "site/assets/js/shared/**/*.js",
        "site/assets/js/forecasts.js",
        "site/assets/js/webcams-v4.js",
        "site/assets/js/guide.js",
        "site/assets/js/wind-data.js",
        "site/assets/js/wind-stations.js",
        "site/assets/js/winds-map.js",
        "site/assets/js/lightstation-charts.js",
        "site/assets/js/lightstation-map.js",
        "site/assets/js/lightstation-page.js",
        "site/assets/js/storm_surge_page.js",
        "site/assets/js/main.js",
        "site/assets/js/buoy-card.js",
        "site/assets/js/buoy-history.js",
        "site/assets/js/stations-map.js",
        "site/assets/js/charts-v4.js",
        "site/assets/js/wave-chart-v4.js",
        "site/assets/js/wind-chart-v4.js",
        "site/assets/js/temperature-chart-v4.js",
        "site/assets/js/comparison-chart-v4.js",
        "site/assets/js/wave-table-v4.js",
        "site/assets/js/storm_surge_chart-v4.js",
        "tests/js/**/*.mjs"
      ],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ],
  "globals": {
    "Chart": "readonly",
    "DOMPurify": "readonly",
    "L": "readonly",
    "logger": "readonly"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "ignoreRestSiblings": true
      }
    ],
    "no-undef": "off",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "AssignmentExpression > MemberExpression.left[property.name=/^on[a-z]/]",
        "message": "Use addEventListener() instead of assigning to event handler properties. See CONTRIBUTING.md."
      },
      {
        "selector": "CallExpression[callee.property.name='setAttribute'][arguments.0.value=/^on[a-z]/]",
        "message": "Use addEventListener() instead of setAttribute() for event handlers. See CONTRIBUTING.md."
      }
    ]
  }
}
