# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Node
node_modules/

# Real data files (don't commit)
data/buoy/
storm_surge/

# Logs (all logs now in logs/ directory)
logs/
*.log

# Environment/credentials
*.env
.config/

# MaxMind GeoIP config (contains license key)
assets/GeoIP.conf
assets/GeoIP.conf.txt

# Cache
.cache/
.npm/
.npm-cache/
*.lock
/tmp/

# Playwright
playwright-report/
test-results/
tests/screenshots/

# Linter output
ruff.out
ruff.err

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Private deployment docs (contain server-specific details)
docs/BACKUP_STATUS.md
docs/DEPLOYMENT.md

# Crontab exports (contain API keys)
config/crontab.txt
config/crontab_clean.txt

# Archive backups (may contain sensitive info)
archive/backups/

# Migration guide (contains server-specific info)
docs/MIGRATION.md

# Allow example data
!examples/
!examples/*.json

# Generated data files (don't commit)
data/
storm_surge/

# JSON data files (but keep examples and requirements.txt)
*.json
!examples/*.json
!requirements.txt
!package.json
!package-lock.json
!.eslintrc.json

# =============================================================================
# Frontend (site/)
# =============================================================================

# Data files (regenerated automatically by backend export scripts)
site/data/

# Analytics (contains sensitive visitor data)
site/analytics.html
site/analytics-weekly.html

# Logs and temp files
site/*.log
site/*.tmp
site/*~
