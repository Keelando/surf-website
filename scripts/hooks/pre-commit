#!/usr/bin/env bash
# Pre-commit hook: runs pytest, ruff, and eslint on staged files.
# Fails fast on first error to keep feedback quick.
#
# Install: ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ── Production guard ─────────────────────────────────────────
# `main` is what halibutbank.ca serves and what cron runs, so it only moves
# via scripts/deploy.py (a fast-forward, no commit) or the nightly crontab
# backup (which sets ALLOW_MAIN_COMMIT). Work happens on `dev`.
if [ "$(git branch --show-current)" = "main" ] && [ -z "${ALLOW_MAIN_COMMIT:-}" ]; then
    echo "⛔ main is production: commit on dev (~/envcan_wave-dev) and ship"
    echo "   with scripts/deploy.py. See docs/DEPLOY.md."
    exit 1
fi

# ── Secrets: scan staged content ─────────────────────────────
# First, because a leaked credential is the one failure a later commit can't
# undo — the repo is public and the 07:17 auto-backup pushes unattended.
echo "🔐 secret scan..."
.venv/bin/python scripts/hooks/check_secrets.py

# ── Python: ruff check ───────────────────────────────────────
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -n "$STAGED_PY" ]; then
    echo "🐍 ruff check (staged .py files)..."
    echo "$STAGED_PY" | xargs .venv/bin/ruff check --no-fix
fi

# ── Asset cache-bust versions: rewrite ?v= to content hashes ─
# Auto-fixes and stages so stale versions can never fail a commit
# (including the nightly auto-backup commit).
UPDATED_HTML=$(.venv/bin/python scripts/update_asset_versions.py | sed -n 's/^updated //p')
if [ -n "$UPDATED_HTML" ]; then
    echo "🔄 asset versions refreshed:"
    echo "$UPDATED_HTML" | sed 's/^/    /'
    echo "$UPDATED_HTML" | xargs git add
fi

# ── Python: pytest (exclude TestSystemHealth — depends on external station availability) ──
echo "🧪 pytest..."
.venv/bin/pytest tests/ -q --tb=line --deselect=tests/test_integration.py::TestSystemHealth

# ── JavaScript: eslint ───────────────────────────────────────
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM -- 'site/assets/js/**/*.js')
if [ -n "$STAGED_JS" ]; then
    echo "📐 eslint (staged .js files)..."
    echo "$STAGED_JS" | xargs npx eslint
fi

echo "✅ All checks passed."
